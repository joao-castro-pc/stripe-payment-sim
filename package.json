{
  "name": "stripe-payment-sim",
  "private": true,
  "description": "Run backend, frontend and Stripe webhook forwarding together for local dev.",
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "dev": "concurrently -n api,web,stripe -c blue,green,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:stripe\"",
    "dev:api": "dotnet watch run --project backend",
    "dev:web": "npm --prefix frontend run dev",
    "dev:stripe": "stripe listen --forward-to localhost:5144/webhook"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
