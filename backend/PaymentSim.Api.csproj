<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>977fe150-7c5f-4204-8fca-8a3aa350f1ef</UserSecretsId>
    <!-- Generate an XML doc file so Swagger can show our /// comments.
         Suppress CS1591 (missing XML comment) so we don't have to document every public member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Emit the OpenAPI document to frontend/openapi.json on every build (no
         running server needed). The frontend generates its TypeScript types from
         this file, so the API contract stays the single source of truth. -->
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\..\frontend</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <!-- Stop `dotnet watch` from reacting to SQLite file writes (*.db / -wal / -shm).
         Every DB write touched these and restarted the server, dropping the SSE stream. -->
    <Watch Remove="**\*.db" />
    <Watch Remove="**\*.db-shm" />
    <Watch Remove="**\*.db-wal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.*" />
    <PackageReference Include="Stripe.net" Version="52.1.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- Build-time OpenAPI document generation (dotnet-getdocument). Build-only,
         not shipped at runtime. -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="9.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
